<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Taskflow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Taskflow">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="bg-gray-900 text-white shadow-md">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">

        <%= link_to "TaskFlow", root_path,
            class: "text-2xl font-bold hover:text-gray-300" %>

        <div class="flex items-center gap-4">

          <% if user_signed_in? %>

            <%= link_to "Projects", projects_path,
                class: "hover:text-gray-300" %>

            <%= link_to "New Project", new_project_path,
                class: "rounded-lg bg-white px-4 py-2 text-gray-900 font-medium hover:bg-gray-200" %>

            <%= button_to "Log Out",
                destroy_user_session_path,
                method: :delete,
                class: "hover:text-gray-300" %>

          <% else %>

            <%= link_to "Log In", new_user_session_path,
                class: "hover:text-gray-300" %>

            <%= link_to "Sign Up", new_user_registration_path,
                class: "rounded-lg bg-white px-4 py-2 text-gray-900 font-medium hover:bg-gray-200" %>

          <% end %>

        </div>
      </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6 py-8">

      <% if notice %>
        <div class="mb-6 rounded-lg bg-green-100 px-4 py-3 text-green-800">
          <%= notice %>
        </div>
      <% end %>

      <% if alert %>
        <div class="mb-6 rounded-lg bg-red-100 px-4 py-3 text-red-800">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>

    </main>
  </body>
</html>
