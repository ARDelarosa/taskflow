<div class="mb-8">

  <h1 class="text-3xl font-bold text-gray-900">
    Search TaskFlow
  </h1>

  <p class="mt-2 text-gray-600">
    Search your projects and tasks.
  </p>

  <% if params[:q].present? %>
    <h2 class="mt-6 text-xl font-semibold text-gray-900">
      Search results for "<%= params[:q] %>"
    </h2>
  <% end %>

<!--Projects Search Results-->

  <% if @projects.any? %>

    <div class="mt-8">

      <h2 class="mb-4 text-xl font-bold text-gray-900">
        Projects
      </h2>

      <div class="space-y-3">

        <% @projects.each do |project| %>

          <%= link_to project_path(project),
              class: "block rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200 hover:ring-gray-300" do %>

            <h3 class="font-semibold text-gray-900">
              <%= project.title %>
            </h3>

            <p class="mt-1 text-sm text-gray-500">
              View project →
            </p>

          <% end %>

        <% end %>

      </div>

    </div>

  <% end %>

<!--Tasks Search Results-->

  <% if @tasks.any? %>

    <div class="mt-8">

      <h2 class="mb-4 text-xl font-bold text-gray-900">
        Tasks
      </h2>

      <div class="space-y-3">

        <% @tasks.each do |task| %>

          <%= link_to project_path(task.project),
              class: "block rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200 hover:ring-gray-300" do %>

            <h3 class="font-semibold text-gray-900">
              <%= task.title %>
            </h3>
            
            <p class="mt-1 text-sm text-gray-500">
              Project: <%= task.project.title %>
            </p>

            <p class="mt-1 text-sm text-gray-500">
              View project →
            </p>

          <% end %>

        <% end %>

      </div>

    </div>

  <% end %>


  <% if params[:q].present? && !@projects.any? && !@tasks.any? %>

    <div class="mt-8 rounded-xl bg-white p-8 text-center shadow-sm ring-1 ring-gray-200">

      <h3 class="text-lg font-semibold text-gray-900">
        No results found
      </h3>

      <p class="mt-2 text-sm text-gray-500">
        We couldn't find any projects or tasks matching
        "<%= params[:q] %>".
      </p>

    </div>

  <% end %>

</div>