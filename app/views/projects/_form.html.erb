<% if project.errors.any? %>
  <div class="mb-6 rounded-lg bg-red-50 p-4 text-red-700">
    <h2 class="font-semibold">
      <%= pluralize(project.errors.count, "error") %>
      prevented this project from being saved:
    </h2>

    <ul class="mt-2 list-disc pl-5">
      <% project.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-200">

  <%= form_with model: project do |form| %>

    <div class="space-y-6">

      <div>
        <%= form.label :title,
            class: "block text-sm font-medium text-gray-700" %>

        <%= form.text_field :title,
            class: "mt-2 block w-full rounded-lg border px-4 py-3 shadow-sm focus:outline-none #{project.errors[:title].any? ? 'border-red-500 focus:border-red-500 focus:ring-1 focus:ring-red-500' : 'border-gray-300 focus:border-gray-900 focus:ring-1 focus:ring-gray-900'}" %>

        <% if project.errors[:title].any? %>
          <p class="mt-2 text-sm text-red-600">
            <%= project.errors[:title].first %>
          </p>
        <% end %>
      </div>

      <div>
        <%= form.label :description,
            class: "block text-sm font-medium text-gray-700" %>

        <%= form.text_area :description,
            rows: 5,
            class: "mt-2 block w-full rounded-lg border px-4 py-3 shadow-sm focus:outline-none #{project.errors[:description].any? ? 'border-red-500 focus:border-red-500 focus:ring-1 focus:ring-red-500' : 'border-gray-300 focus:border-gray-900 focus:ring-1 focus:ring-gray-900'}" %>

        <% if project.errors[:description].any? %>
          <p class="mt-2 text-sm text-red-600">
            <%= project.errors[:description].first %>
          </p>
        <% end %>
      </div>

      <div>
        <%= form.label :due_date,
            class: "block text-sm font-medium text-gray-700" %>

        <%= form.date_field :due_date,
            class: "mt-2 block w-full rounded-lg border px-4 py-3 shadow-sm focus:outline-none #{project.errors[:due_date].any? ? 'border-red-500 focus:border-red-500 focus:ring-1 focus:ring-red-500' : 'border-gray-300 focus:border-gray-900 focus:ring-1 focus:ring-gray-900'}" %>

        <% if project.errors[:due_date].any? %>
          <p class="mt-2 text-sm text-red-600">
            <%= project.errors[:due_date].first %>
          </p>
        <% end %>
      </div>

      <div class="flex items-center gap-3 border-t border-gray-100 pt-6">

        <%= form.submit "Save Project",
            class: "rounded-lg bg-gray-900 px-5 py-3 font-medium text-white hover:bg-gray-700" %>

      </div>

    </div>

  <% end %>

</div>