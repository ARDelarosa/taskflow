<div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-200">

  <div class="flex items-start justify-between gap-6">

    <!-- Project information -->
    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        <%= @project.title %>
      </h1>

      <% if @project.description.present? %>
        <p class="mt-3 text-gray-600">
          <%= @project.description %>
        </p>
      <% end %>

      <% if @project.due_date.present? %>
        <p class="mt-4 text-sm text-gray-500">
          <strong>Due:</strong>
          <%= @project.due_date.strftime("%b %-d, %Y") %>
        </p>
      <% end %>

      <!-- Progress -->
      <div class="mt-6">

        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-gray-700">
            Progress
          </span>

          <span class="text-sm font-medium text-gray-700">
            <%= @completed_tasks %> of <%= @total_tasks %> tasks completed
          </span>
        </div>

        <div class="h-3 w-full rounded-full bg-gray-200">
          <div
            class="h-3 rounded-full bg-gray-900 transition-all"
            style="width: <%= @progress_percentage %>%;">
          </div>
        </div>

        <p class="mt-2 text-right text-sm text-gray-500">
          <%= @progress_percentage %>%
        </p>

      </div>
      <!-- End Progress -->

    </div>
    <!-- End Project information -->

    <!-- Project actions -->
    <div class="flex gap-3">

      <%= link_to "Edit",
          edit_project_path(@project),
          class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-gray-50" %>

      <%= link_to "Delete",
          project_path(@project),
          data: {
            turbo_method: :delete,
            turbo_confirm: "Are you sure you want to delete this project?"
          },
          class: "rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50" %>

    </div>

  </div>

</div>


<div class="mt-10">

  <div class="flex items-center justify-between mb-6">

    <h2 class="text-2xl font-bold">Tasks</h2>

    <%= link_to "New Task",
        new_project_task_path(@project),
        class: "rounded-lg bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700" %>

  </div>

  <div class="mb-6 flex flex-wrap gap-2">

    <%= link_to project_path(@project),
        class: "rounded-lg px-4 py-2 text-sm font-medium #{params[:filter].blank? ? 'bg-gray-900 text-white' : 'border border-gray-300 text-gray-600 hover:bg-gray-50'}" do %>
        All
        <span class="ml-1">(<%= @total_tasks %>)</span>
    <% end %>

    <%= link_to project_path(@project, filter: "active"),
        class: "rounded-lg px-4 py-2 text-sm font-medium #{params[:filter] == 'active' ? 'bg-gray-900 text-white' : 'border border-gray-300 text-gray-600 hover:bg-gray-50'}" do %>
        Active
        <span class="ml-1">(<%= @active_tasks %>)</span>
    <% end %>

    <%= link_to project_path(@project, filter: "completed"),
        class: "rounded-lg px-4 py-2 text-sm font-medium #{params[:filter] == 'completed' ? 'bg-gray-900 text-white' : 'border border-gray-300 text-gray-600 hover:bg-gray-50'}" do %>
        Completed
        <span class="ml-1">(<%= @completed_tasks %>)</span>
    <% end %>

    <%= link_to project_path(@project, filter: "high"),
        class: "rounded-lg px-4 py-2 text-sm font-medium #{params[:filter] == 'high' ? 'bg-gray-900 text-white' : 'border border-gray-300 text-gray-600 hover:bg-gray-50'}" do %>
        High
        <span class="ml-1">(<%= @high_tasks %>)</span>
    <% end %>

    <%= link_to project_path(@project, filter: "medium"),
        class: "rounded-lg px-4 py-2 text-sm font-medium #{params[:filter] == 'medium' ? 'bg-gray-900 text-white' : 'border border-gray-300 text-gray-600 hover:bg-gray-50'}" do %>
        Medium
        <span class="ml-1">(<%= @medium_tasks %>)</span>
    <% end %>

    <%= link_to project_path(@project, filter: "low"),
        class: "rounded-lg px-4 py-2 text-sm font-medium #{params[:filter] == 'low' ? 'bg-gray-900 text-white' : 'border border-gray-300 text-gray-600 hover:bg-gray-50'}" do %>
        Low
        <span class="ml-1">(<%= @low_tasks %>)</span>
    <% end %>

  </div>

  <% if @tasks.any? %>

    <div class="space-y-4">

      <% @tasks.each do |task| %>

        <div class="<%= task.status == "completed" ? 'rounded-xl bg-gray-50 p-6 shadow-sm ring-1 ring-gray-200' : 'rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-200' %>">

          <div class="flex items-start justify-between">

            <div class="flex-1">

              <!-- Status Badge -->

              <h3 class="<%= task.status == 'completed' ? 'text-lg font-semibold text-gray-400 line-through' : 'text-lg font-semibold text-gray-900' %>">
                <%= task.title %>
              </h3>

              <% if task.status == "completed" %>
                <span class="mt-1 inline-block rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-400">
                  Completed
                </span>
              <% elsif task.status == "in_progress" %>
                <span class="mt-1 inline-block rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-700">
                  In Progress
                </span>
              <% else %>
                <span class="mt-1 inline-block rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-gray-600">
                  To Do
                </span>
              <% end %>

              <!-- Priority Badge -->

              <% if task.status == "completed" %>
                <span class="mt-1 inline-block rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-400">
                  <%= task.priority.humanize %>
                </span>
              <% elsif task.high? %>
                <span class="mt-1 inline-block rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700">
                  High
                </span>
              <% elsif task.medium? %>
                <span class="mt-1 inline-block rounded-full bg-yellow-100 px-2.5 py-1 text-xs font-semibold text-yellow-700">
                  Medium
                </span>
              <% else %>
                <span class="mt-1 inline-block rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700">
                  Low
                </span>
              <% end %>

              <!-- Task Details and Due Date -->

              <% if task.details.present? %>
                <p class="<%= task.status == 'completed' ? 'mt-2 text-gray-400 line-through' : 'mt-2 text-gray-600' %>">
                  <%= task.details %>

                </p>
              <% end %>

              <% if task.due_date.present? %>

                  <% if task.due_date.present? && task.status != "completed" && task.due_date < Date.current %>

                      <p class="mt-3 text-sm font-semibold text-red-600">
                      ⚠ Overdue:
                      <%= task.due_date.strftime("%b %-d, %Y") %>
                      </p>

                  <% elsif task.status == "completed" %>

                      <p class="mt-3 text-sm text-gray-400 line-through">
                      Due:
                      <%= task.due_date.strftime("%b %-d, %Y") %>
                      </p>

                  <% else %>

                      <p class="mt-3 text-sm text-gray-500">
                      Due:
                      <%= task.due_date.strftime("%b %-d, %Y") %>
                      </p>

                  <% end %>

              <% end %>

            </div>

            <div class="ml-6">

              <%= form_with model: [@project, task], method: :patch do |form| %>

                <%= form.label :status,
                    "Status",
                    class: "block text-sm font-medium text-gray-700" %>

                <%= form.select :status,
                    Task.statuses.keys.map { |status| [status.humanize, status] },
                    {},
                    onchange: "this.form.requestSubmit()",
                    class: "mt-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
              <% end %>

            </div>

          </div>

          <div class="mt-5 flex gap-3 border-t border-gray-100 pt-4">

            <%= link_to "Edit",
                edit_project_task_path(@project, task),
                class: "rounded-lg border border-gray-300 px-3 py-2 text-sm font-medium hover:bg-gray-50" %>

            <%= link_to "Delete",
                project_task_path(@project, task),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete this task?"
                },
                class: "rounded-lg border border-red-300 px-3 py-2 text-sm font-medium text-red-600 hover:bg-red-50" %>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="rounded-xl bg-white p-10 text-center shadow-sm ring-1 ring-gray-200">

      <% if params[:filter] == "active" %>

        <h3 class="text-xl font-semibold text-gray-900">
          No active tasks
        </h3>

        <p class="mt-2 text-gray-600">
          All of your tasks are completed!
        </p>

      <% elsif params[:filter] == "completed" %>

        <h3 class="text-xl font-semibold text-gray-900">
          No completed tasks
        </h3>

        <p class="mt-2 text-gray-600">
          Complete a task and it will appear here.
        </p>

      <% elsif params[:filter] == "high" %>

        <h3 class="text-xl font-semibold text-gray-900">
          No high-priority tasks
        </h3>

        <p class="mt-2 text-gray-600">
          Create a new task to get started.
        </p>

        <%= link_to "Create New Task",
            new_project_task_path(@project),
            class: "mt-6 inline-block rounded-lg bg-gray-900 px-5 py-3 font-medium text-white hover:bg-gray-700" %>

      <% elsif params[:filter] == "medium" %>

        <h3 class="text-xl font-semibold text-gray-900">
          No medium-priority tasks
        </h3>

        <p class="mt-2 text-gray-600">
          Create a new task to get started.
        </p>

        <%= link_to "Create New Task",
            new_project_task_path(@project),
            class: "mt-6 inline-block rounded-lg bg-gray-900 px-5 py-3 font-medium text-white hover:bg-gray-700" %>

      <% elsif params[:filter] == "low" %>

        <h3 class="text-xl font-semibold text-gray-900">
          No low-priority tasks
        </h3>

        <p class="mt-2 text-gray-600">
          Create a new task to get started.
        </p>

        <%= link_to "Create New Task",
            new_project_task_path(@project),
            class: "mt-6 inline-block rounded-lg bg-gray-900 px-5 py-3 font-medium text-white hover:bg-gray-700" %>

      <% else %>

        <h3 class="text-xl font-semibold text-gray-900">
          No tasks yet
        </h3>

        <p class="mt-2 text-gray-600">
          Add your first task to start making progress on this project.
        </p>

        <%= link_to "Create New Task",
            new_project_task_path(@project),
            class: "mt-6 inline-block rounded-lg bg-gray-900 px-5 py-3 font-medium text-white hover:bg-gray-700" %>

      <% end %>

    </div>

  <% end %>

</div>

<div class="mt-8">
  <%= link_to "← Back to My Projects",
      projects_path,
      class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
</div>