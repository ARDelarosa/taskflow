<div class="mx-auto max-w-md">

  <div class="mb-8 text-center">
    <h1 class="text-3xl font-bold text-gray-900">
      Welcome back
    </h1>

    <p class="mt-2 text-gray-600">
      Sign in to manage your projects and tasks.
    </p>
  </div>

  <div class="rounded-xl bg-white p-8 shadow-sm ring-1 ring-gray-200">

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="space-y-6">

        <div>
          <%= f.label :email,
              class: "block text-sm font-medium text-gray-700" %>

          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "mt-2 block w-full rounded-lg border border-gray-300 px-4 py-3 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
        </div>

        <div>
          <%= f.label :password,
              class: "block text-sm font-medium text-gray-700" %>

          <%= f.password_field :password,
              autocomplete: "current-password",
              class: "mt-2 block w-full rounded-lg border border-gray-300 px-4 py-3 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900" %>
        </div>

        <% if devise_mapping.rememberable? %>

          <div class="flex items-center gap-2">

            <%= f.check_box :remember_me,
                class: "rounded border-gray-300" %>

            <%= f.label :remember_me,
                class: "text-sm text-gray-600" %>

          </div>

        <% end %>

        <div>

          <%= f.submit "Log in",
              class: "w-full rounded-lg bg-gray-900 px-5 py-3 font-medium text-white hover:bg-gray-700" %>

        </div>

      </div>

    <% end %>

    <div class="mt-6 border-t border-gray-100 pt-6 text-center">

      <%= render "devise/shared/links" %>

    </div>

  </div>

</div>
